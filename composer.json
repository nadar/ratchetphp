{
  "name": "nadar/ratchetphp",
  "type": "library",
  "description": "PHP WebSocket library (PHP 8.5 compatible fork of Ratchet)",
  "keywords": [
    "WebSockets",
    "Server",
    "Ratchet",
    "Sockets",
    "WebSocket"
  ],
  "homepage": "http://socketo.me",
  "license": "MIT",
  "authors": [
    {
      "name": "Chris Boden",
      "email": "cboden@gmail.com",
      "role": "Developer"
    },
    {
      "name": "Matt Bonneau",
      "role": "Developer"
    },
    {
      "name": "Alexey Yuzhakov",
      "role": "Developer"
    }
  ],
  "autoload": {
    "psr-4": {
      "Ratchet\\": "src/Ratchet"
    }
  },
  "require": {
    "php": "^8.5",
    "ratchet/rfc6455": "^0.4.0",
    "react/socket": "^1.13.0",
    "react/event-loop": "^1.4.0",
    "guzzlehttp/psr7": "^2.5.0",
    "symfony/http-foundation": "^7.0",
    "symfony/routing": "^7.0"
  },
  "config": {
    "platform": {
      "php": "8.5.0"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6.9",
    "squizlabs/php_codesniffer": "^3.7",
    "phpcompatibility/php-compatibility": "^9.3"
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "compat": "phpcs -p --standard=vendor/phpcompatibility/php-compatibility/PHPCompatibility --runtime-set testVersion 8.5 src",
    "check:compat": [
      "@compat",
      "@test"
    ]
  }
}
